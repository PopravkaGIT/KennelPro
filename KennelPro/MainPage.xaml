<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KennelPro.MainPage"
             Title="KennelPro">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <Label
                x:Name="WelcomeLabel"
                Text="Welcome!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                x:Name="KennelLabel"
                Text=""
                FontSize="18"
                TextColor="{StaticResource Gray600}" />

            <Label
                Text="Your kennel management dashboard"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <Button
                x:Name="DogsBtn"
                Text="Dogs"
                Clicked="OnDogsClicked"
                FontSize="18"
                HeightRequest="52"
                HorizontalOptions="Fill" />
            <Button Text="Reproduction" Clicked="OnReproductionClicked" FontSize="18" HeightRequest="52" HorizontalOptions="Fill" />

            <Button
                Text="Sign Out"
                Clicked="OnLogoutClicked"
                FontSize="18"
                HeightRequest="52"
                HorizontalOptions="Fill"
                Margin="0,24,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
