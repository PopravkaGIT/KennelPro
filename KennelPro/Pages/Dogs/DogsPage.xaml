<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KennelPro.ViewModels.Dogs"
             x:Class="KennelPro.Pages.Dogs.DogsPage"
             x:DataType="vm:DogListViewModel"
             Title="Dogs">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <SearchBar
            Grid.Row="0"
            Placeholder="Search by name"
            Text="{Binding SearchText}"
            FontSize="18"
            HeightRequest="48" />

        <Button
            Grid.Row="1"
            Text="Add Dog"
            Command="{Binding AddDogCommand}"
            FontSize="18"
            HeightRequest="52" />

        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView
                ItemsSource="{Binding Dogs}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label
                            Text="No dogs yet"
                            FontSize="20"
                            HorizontalOptions="Center" />
                        <Label
                            Text="Tap Add Dog to create your first dog."
                            FontSize="16"
                            TextColor="{StaticResource Gray600}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DogListItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem
                                        Text="Edit"
                                        BackgroundColor="{StaticResource Primary}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditDogCommand}"
                                        CommandParameter="{Binding .}" />
                                    <SwipeItem
                                        Text="Delete"
                                        BackgroundColor="#C62828"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDogCommand}"
                                        CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border
                                Stroke="{StaticResource Gray200}"
                                Padding="16"
                                Margin="0,0,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectDogCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="20"
                                        FontAttributes="Bold" />
                                    <Label
                                        Text="{Binding BreedName}"
                                        FontSize="16"
                                        TextColor="{StaticResource Gray600}" />
                                    <HorizontalStackLayout Spacing="16">
                                        <Label
                                            Text="{Binding GenderText}"
                                            FontSize="16" />
                                        <Label
                                            Text="{Binding BirthDateText}"
                                            FontSize="16"
                                            TextColor="{StaticResource Gray600}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
