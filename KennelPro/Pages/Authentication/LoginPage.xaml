<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KennelPro.ViewModels.Authentication"
             x:Class="KennelPro.Pages.Authentication.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="KennelPro"
                FontSize="36"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="{StaticResource Primary}" />

            <Label
                Text="Sign in to your kennel"
                FontSize="18"
                HorizontalOptions="Center"
                TextColor="{StaticResource Gray600}" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Email" FontSize="16" />
                <Entry
                    Text="{Binding Email}"
                    Placeholder="your@email.com"
                    Keyboard="Email"
                    FontSize="18"
                    HeightRequest="52" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Password" FontSize="16" />
                <Entry
                    Text="{Binding Password}"
                    Placeholder="Password"
                    IsPassword="True"
                    FontSize="18"
                    HeightRequest="52" />
            </VerticalStackLayout>

            <Button
                Text="Sign In"
                Command="{Binding LoginCommand}"
                FontSize="18"
                HeightRequest="52"
                Margin="0,8,0,0" />

            <Button
                Text="Create Account"
                Command="{Binding GoToRegisterCommand}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Primary}"
                FontSize="16"
                HeightRequest="48" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
