<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="KennelPro.Pages.Reproduction.ReproductionPage" Title="{Binding Title}"><ScrollView><VerticalStackLayout Padding="16" Spacing="16"><Button Text="Refresh" Command="{Binding RefreshCommand}" HeightRequest="52" FontSize="18"/><Label Text="Heat cycles" FontSize="22" FontAttributes="Bold"/><CollectionView ItemsSource="{Binding HeatCycles}" HeightRequest="180"><CollectionView.ItemTemplate><DataTemplate><Border Stroke="{StaticResource Gray200}" Padding="12" Margin="0,4"><Label Text="{Binding StartDate, StringFormat='Start: {0:d}'}" FontSize="17"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Label Text="Matings" FontSize="22" FontAttributes="Bold"/><CollectionView ItemsSource="{Binding Matings}" HeightRequest="180"><CollectionView.ItemTemplate><DataTemplate><Border Stroke="{StaticResource Gray200}" Padding="12" Margin="0,4"><Label Text="{Binding Date, StringFormat='Date: {0:d}'}" FontSize="17"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Label Text="Litters" FontSize="22" FontAttributes="Bold"/><CollectionView ItemsSource="{Binding Litters}" HeightRequest="180"><CollectionView.ItemTemplate><DataTemplate><Border Stroke="{StaticResource Gray200}" Padding="12" Margin="0,4"><Label Text="{Binding Name}" FontSize="17"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Button Text="Back" Command="{Binding BackCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" HeightRequest="48"/></VerticalStackLayout></ScrollView></ContentPage>
