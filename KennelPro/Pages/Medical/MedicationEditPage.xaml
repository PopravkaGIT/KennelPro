<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:KennelPro.ViewModels.Medical" x:Class="KennelPro.Pages.Medical.MedicationEditPage" x:DataType="vm:MedicationEditViewModel" Title="{Binding PageTitle}"><ScrollView><VerticalStackLayout Padding="16" Spacing="16"><Label Text="Medication name" FontSize="16"/><Entry Text="{Binding Name}" FontSize="18" HeightRequest="52"/><Label Text="Dosage" FontSize="16"/><Entry Text="{Binding Dosage}" Placeholder="For example, 1 tablet" FontSize="18" HeightRequest="52"/><Label Text="Frequency" FontSize="16"/><Entry Text="{Binding Frequency}" Placeholder="For example, twice daily" FontSize="18" HeightRequest="52"/><Label Text="Start date" FontSize="16"/><DatePicker Date="{Binding StartDate}" FontSize="18" HeightRequest="52"/><HorizontalStackLayout Spacing="12"><Switch IsToggled="{Binding HasEndDate}"/><Label Text="Set end date" FontSize="16" VerticalOptions="Center"/></HorizontalStackLayout><DatePicker Date="{Binding EndDate}" IsVisible="{Binding HasEndDate}" FontSize="18" HeightRequest="52"/><Button Text="Save" Command="{Binding SaveCommand}" FontSize="18" HeightRequest="52"/><Button Text="Cancel" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" FontSize="16" HeightRequest="48"/></VerticalStackLayout></ScrollView></ContentPage>
